#!/usr/bin/env bash
# Wrapper so Go can exec a stable path. Exec into pixi's python so the
# supervised PID is the worker itself (not a pixi parent shell).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PY="$ROOT/.pixi/envs/default/bin/python"
if [[ ! -x "$PY" ]]; then
  # First-time / missing env: create via pixi, then exec python.
  pixi install --manifest-path "$ROOT/pixi.toml" >/dev/null
fi
exec "$PY" "$ROOT/server.py" "$@"
